<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件的布局。

  ⚠️ RemoteViews 只支持有限的 View 类型：LinearLayout / FrameLayout / RelativeLayout /
  TextView / ImageView / Button / ProgressBar 等。**不能用 ConstraintLayout**，也不能用
  自定义 View，否则小组件会渲染失败（表现为白块或系统提示"加载失败"）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/nexus_widget_surface"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nexus_command_widget_title"
        android:textColor="@color/nexus_widget_title"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <Button
        android:id="@+id/widget_describe_agent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp"
        android:text="@string/shortcut_describe_agent_short"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:background="@drawable/nexus_widget_action_primary"
        android:textColor="@color/nexus_widget_action_primary_text"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_new_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/shortcut_new_chat_short"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:background="@drawable/nexus_widget_action_secondary"
            android:textColor="@color/nexus_widget_action_secondary_text"/>

        <Button
            android:id="@+id/widget_memory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/shortcut_memory_short"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:background="@drawable/nexus_widget_action_secondary"
            android:textColor="@color/nexus_widget_action_secondary_text"/>
    </LinearLayout>

</LinearLayout>
